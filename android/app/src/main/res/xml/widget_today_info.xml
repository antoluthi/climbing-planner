<?xml version="1.0" encoding="utf-8"?>
<!-- 4 colonnes × 3 lignes environ : de quoi tenir quatre rappels et le journal.
     `updatePeriodMillis` est plafonné par Android à 30 min ; le rafraîchissement
     qui compte vient de MainActivity.onPause, quand on quitte l'app. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
