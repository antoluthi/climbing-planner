<?xml version="1.0" encoding="utf-8"?>
<!-- Widget redimensionnable.

     `resizeMode` ne suffit pas : sans `minResizeWidth`/`minResizeHeight`,
     Android prend `minWidth`/`minHeight` comme plancher, si bien que le widget
     ne peut que **grandir**. Les deux couples disent donc deux choses
     différentes :

       · minWidth / minHeight            la taille à la pose (Android 11 et avant)
       · targetCellWidth / targetCellHeight   idem, en cellules (Android 12+)
       · minResizeWidth / minResizeHeight     jusqu'où on peut le réduire
       · maxResizeWidth / maxResizeHeight     jusqu'où on peut l'étirer

     Le contenu suit : TodayWidget.fit() lit la taille réelle et décide combien
     de rappels tiennent, et si la date et le journal ont encore leur place.

     `updatePeriodMillis` est plafonné par Android à 30 min ; le rafraîchissement
     qui compte vient de MainActivity.onPause, quand on quitte l'app. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="110dp"
    android:minResizeHeight="70dp"
    android:maxResizeWidth="500dp"
    android:maxResizeHeight="440dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
