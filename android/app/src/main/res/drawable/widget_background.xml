<?xml version="1.0" encoding="utf-8"?>
<!-- Le widget ne peut pas suivre le thème de l'app (il vit dans le lanceur) :
     il prend le noir de la DA, qui tient sur n'importe quel fond d'écran. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0A0A0A" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
